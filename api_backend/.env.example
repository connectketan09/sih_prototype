# ============================================================
# IP-SAKTI Sahayak — API Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your own credentials.
# NEVER commit the real .env file.
#
# Obtain Bhashini credentials from:
# https://bhashini.gov.in/ulca/user/register
# → My Profile → API Keys
#
# Your ULCA User ID
BHASHINI_USER_ID="your-ulca-user-id"

# Your ULCA API Key (used as ulcaApiKey in Pipeline Config call header)
BHASHINI_UDYAT_API_KEY="your-udyat-api-key"

# Your Inference API Key (used as Authorization header in Pipeline Compute call)
BHASHINI_INFERENCE_API_KEY="your-inference-api-key"

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5050
